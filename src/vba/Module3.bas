Attribute VB_Name = "Module3"
' ??? ?????: GitExporter
Public Sub ExportAllModules()
    Dim component As Object
    Dim folderPath As String
    Dim fso As Object
    
    ' ????? ???? ???? src\vba ?? ???? ???? ????
    folderPath = ThisWorkbook.Path & "\src\vba\"
    
    ' ????? ???? ?? ???? ?????
    If Dir(folderPath, vbDirectory) = "" Then MkDir folderPath
    
    ' ??? ???????? ???? ???? ????? ????? ??? ??? ?? ??? ?? ??? ????
    Dim fileName As String
    fileName = Dir(folderPath & "*.*")
    Do While fileName <> ""
        Kill folderPath & fileName
        fileName = Dir
    Loop
    
    ' ??????? ???? ???? ????????? ??????? ? ??????
    For Each component In ThisWorkbook.VBProject.VBComponents
        ' ????????? ??????? ??????? ? ?????? ??????? ??????? (Type 1, 2, 3)
        ' ?????? ? ThisWorkbook (Type 100) ??????? ???? ?? ??????? ??????
        If component.Type = 1 Or component.Type = 2 Or component.Type = 3 Then
            component.Export folderPath & component.Name & _
            IIf(component.Type = 1, ".bas", IIf(component.Type = 2, ".cls", ".frm"))
        End If
    Next component
End Sub


